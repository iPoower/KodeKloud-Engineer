#!/usr/bin/env bash
# KodeKloud / Nautilus — créer un utilisateur système Apache sur un serveur de labo.
# Aucun mot de passe, aucune adresse personnelle ni contournement de vérification de clé SSH.
set -euo pipefail

: "${LAB_SSH_HOST:?Définis LAB_SSH_HOST}"
: "${LAB_SSH_USER:?Définis LAB_SSH_USER}"

# Vérifier au préalable la clé hôte SSH auprès de l'administrateur du laboratoire.
# Utiliser ssh-agent ou la clé SSH configurée localement, pas de mot de passe dans le dépôt.
ssh -o BatchMode=yes -o StrictHostKeyChecking=yes "${LAB_SSH_USER}@${LAB_SSH_HOST}" '
  set -eu
  if ! id -u ravi >/dev/null 2>&1; then
    sudo useradd -u 1648 -d /var/www/ravi ravi
  fi
  test "$(id -u ravi)" -eq 1648
  test "$(getent passwd ravi | cut -d: -f6)" = "/var/www/ravi"
  id ravi
'

# Historique : un ancien commit comportait un identifiant de laboratoire.
# La suppression du fichier courant ne purge PAS l'historique Git.
